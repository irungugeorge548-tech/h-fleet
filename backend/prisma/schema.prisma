generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// An H-Fleet rider. Has its own password; hpesaPhone is the optional link to an H-Pesa wallet.
model User {
  id         String   @id @default(cuid())
  name       String
  phone      String   @unique
  email      String?  @unique
  password   String
  pin        String?  // unused (the PIN belongs to H-Pesa); kept so older databases keep working
  hpesaPhone String?
  role       String   @default("RIDER")
  createdAt  DateTime @default(now())
}

model Ride {
  id          String   @id @default(cuid())
  riderId     String   // H-Fleet user id
  riderPhone  String?
  pickup      String
  pickupLat   Float?
  pickupLng   Float?
  destination String
  destLat     Float?
  destLng     Float?
  distanceKm  Float?
  fare        Float
  status      String   @default("PENDING") // PENDING, ACCEPTED, FAILED, CANCELLED, COMPLETED
  failReason  String? @db.Text
  driverName  String?
  createdAt   DateTime @default(now())

  @@index([riderId])
}

model EmergencyContact {
  id        String   @id @default(cuid())
  userId    String
  name      String
  phone     String
  createdAt DateTime @default(now())

  @@index([userId])
}

model SupportMessage {
  id        String   @id @default(cuid())
  userId    String
  userName  String?
  userPhone String?
  subject   String
  message   String @db.Text
  status    String   @default("OPEN")
  createdAt DateTime @default(now())

  @@index([userId])
}
